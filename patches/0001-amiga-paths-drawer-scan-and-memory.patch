+#endif
   if (!IsPathSepar(dirPath.Back()))
     dirPath.Add_PathSepar();
 }
@@ -61,6 +66,10 @@ void NormalizeDirPathPrefix(UString &dirPath)
 {
   if (dirPath.IsEmpty())
     return;
+#ifdef __amigaos__
+  if (dirPath.Back() == ':')
+    return;
+#endif
   if (!IsPathSepar(dirPath.Back()))
     dirPath.Add_PathSepar();
 }
@@ -412,7 +421,31 @@ unsigned GetRootPrefixSize_WINDOWS(const wchar_t *s) throw()
   return GetRootPrefixSize_Of_SimplePath(s);
 }
 
-#ifndef _WIN32
+#if !defined(_WIN32) && defined(__amigaos__)
+
+/* AmigaDOS: an absolute path names its volume or assign ("Work:", "RAM:x");
+   a leading "/" means the parent drawer, so it is relative */
+template <class T> static unsigned Amiga_RootPrefixSize(const T *s) throw()
+{
+  for (unsigned i = 0; s[i] != 0; i++)
+  {
+    if (s[i] == ':')
+      return i + 1;
+    if (s[i] == '/')
+      return 0;
+  }
+  return 0;
+}
+
+bool IsAbsolutePath(const wchar_t *s) throw() { return Amiga_RootPrefixSize(s) != 0; }
+
+#ifndef USE_UNICODE_FSTRING
+unsigned GetRootPrefixSize(CFSTR s) throw();
+unsigned GetRootPrefixSize(CFSTR s) throw() { return Amiga_RootPrefixSize(s); }
+#endif
+unsigned GetRootPrefixSize(const wchar_t *s) throw() { return Amiga_RootPrefixSize(s); }
+
+#elif !defined(_WIN32)
 
 bool IsAbsolutePath(const wchar_t *s) throw() { return IS_SEPAR(s[0]); }
 
