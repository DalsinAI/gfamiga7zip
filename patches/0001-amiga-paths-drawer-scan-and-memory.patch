--- a/CPP/Windows/FileName.cpp
+++ b/CPP/Windows/FileName.cpp
@@ -52,6 +52,11 @@ void NormalizeDirPathPrefix(FString &dirPath)
 {
   if (dirPath.IsEmpty())
     return;
+#ifdef __amigaos__
+  // "Work:" is a volume's root: "Work:/" would be its parent
+  if (dirPath.Back() == ':')
